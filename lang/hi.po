msgstr "मुक्तहस्त बनाने के लिए खींचें।"

#: src/editor/PropsPanel.cpp:101
msgid "Arraste um retângulo sobre o que quer destacar. A cor e a opacidade vêm das propriedades."
msgstr "जिसे हाइलाइट करना है उस पर आयत खींचें। रंग और अपारदर्शिता गुणों से आते हैं।"

#: src/editor/PropsPanel.cpp:102
msgid "Clique ou arraste para criar uma caixa de texto. Duplo clique edita o texto."
msgstr "पाठ बॉक्स बनाने के लिए क्लिक करें या खींचें। डबल-क्लिक पाठ संपादित करता है।"

#: src/editor/PropsPanel.cpp:103
msgid "Arraste para criar o balão e digite. A alça amarela move a ponta (ou a direção das setas)."
msgstr "कॉलआउट बनाने के लिए खींचें और टाइप करें। पीला हैंडल नोक (या तीरों की दिशा) को हिलाता है।"

