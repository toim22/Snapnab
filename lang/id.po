#: rust/snapnab/src/cmdline.rs:111
msgid ""
"Snapnab.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o Snapnab em execução"
msgstr ""
"Snapnab.exe [opsi]\n"
"\n"
"/hide                 mulai hanya di baki sistem\n"
"/capture              ambil gambar dengan preset gambar saat ini\n"
"/video                rekam video dengan preset video saat ini\n"
"/preset \"nama\"      jalankan preset berdasarkan nama\n"
"/clipboard            ambil gambar dari papan klip\n"
"/region x,y,l,t       menangkap area layar ini\n"
"/window \"judul\"     menangkap jendela yang judulnya memuat teks\n"
"/monitor n            menangkap monitor n (1, 2…, dari kiri ke kanan)\n"
"/fullscreen           menangkap seluruh layar\n"
"/delay s              menunggu s detik sebelum menangkap\n"
"/ocr  /qr  /upload    mengenali teks, membaca kode QR, atau mengunggah tangkapan\n"
"/pin [file]           menyematkan file di layar (tanpa file: menangkap dan menyematkan)\n"
"/pinclipboard         menyematkan isi papan klip\n"
"/colorpicker          membuka pengambil warna layar\n"
"/focus                menyalakan atau mematikan fokus layar\n"
"/interval [stop]      memulai (atau menghentikan) tangkapan berinterval\n"
"/output clipboard|editor|none|\"file\"   ke mana tangkapan dikirim\n"
"/exit                 tutup Snapnab yang sedang berjalan"

