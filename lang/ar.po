#: src/capture/main.cpp:735
msgid ""
"Snapnab.exe [opções]\n"
"\n"
"/hide            inicia só na bandeja\n"
"/capture         captura imagem com o preset de imagem atual\n"
"/video           grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"   executa um preset pelo nome\n"
"/clipboard       captura a imagem da área de transferência\n"
"/exit            encerra o Snapnab em execução"
msgstr ""
"Snapnab.exe [خيارات]\n"
"\n"
"/hide            البدء في منطقة الإعلامات فقط\n"
"/capture         التقاط صورة بالإعداد المسبق الحالي للصور\n"
"/video           تسجيل فيديو بالإعداد المسبق الحالي للفيديو\n"
"/preset \"الاسم\"  تشغيل إعداد مسبق بالاسم\n"
"/clipboard       التقاط الصورة من الحافظة\n"
"/exit            إغلاق Snapnab قيد التشغيل"

