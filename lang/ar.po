#: src/editor/main.cpp:1311
msgid ""
"SnapnabEditor.exe [opções] [arquivo…]\n"
"\n"
"/Open \"arquivo\"     abre um arquivo (.snap, imagem, .mp4)\n"
"/NewFromClipboard   cria imagem a partir da área de transferência\n"
"/restartwait        espera a instância anterior fechar"
msgstr ""
"SnapnabEditor.exe [خيارات] [ملف…]\n"
"\n"
"/Open \"ملف\"        يفتح ملفًا (.snap، صورة، .mp4)\n"
"/NewFromClipboard   ينشئ صورة من الحافظة\n"
"/restartwait        ينتظر إغلاق النسخة السابقة"

